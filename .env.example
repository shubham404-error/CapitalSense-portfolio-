# Public browser configuration. Legacy anon keys also work as this key value.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Gemini credentials are Supabase Edge Function secrets, not frontend variables.
# Configure GEMINI_API_KEY, GEMINI_MODEL and ALLOWED_ORIGINS in Supabase.
# Never place service-role keys or Gemini credentials in NEXT_PUBLIC_* variables.
