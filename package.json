{
  "name": "capitalsense-stride",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node tests/smoke.cjs",
    "build:pages": "node scripts/build-pages.mjs",
    "build:worker": "node scripts/build-pages.mjs /stride",
    "preview:worker": "npm run build:worker && wrangler dev",
    "deploy:worker": "npm run build:worker && wrangler deploy",
    "check:worker": "npm run typecheck && npm run test:backend && npm run build:worker && wrangler deploy --dry-run",
    "test:backend": "node tests/backend.cjs && node tests/rule-guide.cjs && node tests/expense-tracker.cjs && node tests/expense-backend.cjs && node tests/social-backend.cjs",
    "test:auth": "node tests/auth.cjs",
    "test:mobile": "node tests/mobile.cjs",
    "test:lenses": "node tests/lenses.cjs",
    "test:google-auth": "node tests/google-auth.cjs",
    "test:profile": "node tests/profile-page.cjs",
    "test:funds": "node tests/funds.cjs",
    "test:guide-sharing": "node tests/guide-sharing.cjs",
    "test:mfapi": "node tests/mfapi.cjs",
    "test:fund-research": "node tests/fund-research.cjs",
    "test:assetplus": "node tests/assetplus.cjs",
    "test:launch-journey": "node tests/launch-journey.cjs",
    "test:holdings-storage": "node tests/holdings-storage.cjs",
    "test:manual-holdings": "node tests/manual-holdings.cjs",
    "test:expenses": "node tests/expense-tracker.cjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "wrangler": "4.158.0"
  }
}
